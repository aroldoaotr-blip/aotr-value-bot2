# ⚙️ Opcionales — preferible configurarlos en Discord con /config
# Los canales de precios y bienvenidas se guardan POR SERVIDOR en la BD.
# Estas variables solo actúan como canal por defecto cuando el servidor
# no tiene uno configurado.
# WELCOME_CHANNEL_ID="id-del-canal-de-bienvenidas"   # fallback de /config bienvenida
# AUTO_ROLE_ID="id-del-rol-para-nuevos-miembros"     # rol automático al entrar
# MEMBER_COUNT_CHANNEL_ID="id-del-canal-de-voz"      # voz con el nº de miembros
# WIKI_CHANNEL_ID="id-del-canal-de-wiki"             # canal dedicado wiki
# LEGACY_VALUES_CHANNEL_ID="id-del-canal-de-precios" # fallback de /config canal
