// AOTR Value Platform — Esquema de 2 listas de precios independientes
// Bot + Web comparten esta base de datos.
//
// ── OfficialPrice  = precios oficiales (hoja AOTR / Excel)
// ── TradePrice     = precios de tradeo (API externa)
//
// Cada lista tiene SU propio histórico y su propio script de sync.
// Lo único compartido entre listas es:
//   · id = stableId(nombre normalizado)  → llave de join (mismo item)
//   · la imagen (emoji) que trae la API → la web la aplica al item oficial

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
  // Motores para TODAS las plataformas: Windows (local), Vercel (debian/rhel),
  // Railway (debian o alpine/musl). Sin esto, `prisma generate` en Windows
  // solo emite el binario de Windows y producción (Linux) no puede conectar
  // a la BD (error 500 en /api/rates, "Sin base de datos" en la web).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para migraciones: `prisma db push` / `migrate`
  // usan DIRECT_URL; el runtime (web/bot) usa DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ── LISTA 1 · Precios oficiales (hoja AOTR) ─────────────────────────
model OfficialPrice {
  id             String   @id // stableId(nombre) — llave compartida con TradePrice
  name           String
  normalized     String   @unique
  slug           String   @unique
  category       String?
  rarityLabel    String?
  demand         String?
  // Los 3 precios — pueden ser número o rango { min, max } según la hoja
  keys           Json?
  scrolls        Json?
  vizards        Json?
  rateOfChange   String?
  taxGems        Float?
  taxGold        Float?
  sheet          String? // Hoja de Excel de origen
  existingAmount String? // Cantidad existente registrada en la hoja
  updatedAt      DateTime @updatedAt

  history OfficialPriceHistory[]

  @@index([category])
}

model OfficialPriceHistory {
  id         Int      @id @default(autoincrement())
  itemId     String // stableId del item (mid de rango si aplica)
  item       OfficialPrice @relation(fields: [itemId], references: [id], onDelete: Cascade)
  keys       Float?
  scrolls    Float?
  vizards    Float?
  recordedAt DateTime @default(now())

  @@unique([itemId, recordedAt])
  @@index([itemId, recordedAt])
}

// ── LISTA 2 · Precios de tradeo (API externa) ────────────────────────
model TradePrice {
  id           String   @id // stableId(nombre) — misma llave que OfficialPrice
  name         String
  normalized   String   @unique
  slug         String   @unique
  category     String?
  rarityPct    Float?
  emoji        String? // imagen compartida → https://www.aotrvalue.com + emoji
  value        Float? // viz original de la API
  keys         Float? // calculado: viz × keysPerVizard (tasas del admin)
  scrolls      Float? // calculado: keys / keysPerScroll
  demand       Int?
  rateOfChange String?
  prestige     Int?
  status       String?
  obtainedFrom String?
  taxGems      Float?
  taxGold      Float?
  apiId        String? // id del item en la API externa
  apiUpdatedAt DateTime? // fecha de actualización según la API
  updatedAt    DateTime @updatedAt

  history TradePriceHistory[]

  @@index([category])
  @@index([status])
  @@index([value])
}

model TradePriceHistory {
  id         Int      @id @default(autoincrement())
  itemId     String // stableId del item
  item       TradePrice @relation(fields: [itemId], references: [id], onDelete: Cascade)
  value      Float? // viz
  demand     Int?
  recordedAt DateTime @default(now())

  @@unique([itemId, recordedAt])
  @@index([itemId, recordedAt])
}

// ── Bitácora de sincronización ───────────────────────────────────────
model SyncLog {
  id         Int      @id @default(autoincrement())
  source     String // "official" | "trade"
  status     String // "ok" | "error"
  rows       Int?
  error      String?
  durationMs Int?
  startedAt  DateTime @default(now())

  @@index([source, startedAt])
}

// ── Tasas de conversión configurables (admin) ────────────────────────
// 1 Vizard = keysPerVizard llaves
// 1 Pergamino = keysPerScroll llaves (3 llaves por defecto)
// Fuente de verdad única: bot + web + seed la leen de aquí.
// Se aplican a AMBAS listas para completar/calcular los 3 precios.
model RateConfig {
  id            String   @id @default("default")
  // Alineado con la API de tradeo (1 viz = 900.9 llaves) — editable por admin
  keysPerVizard Float    @default(900.9)
  keysPerScroll Float    @default(3)
  updatedAt     DateTime @updatedAt
}

// ── Configuración global del sitio (web) ─────────────────────────────
// Valores que aplican a TODOS los visitantes de la web (no por navegador).
// Ej: heroMode — qué fondo muestra el Home ("video" | "shader").
model SiteConfig {
  id       String   @id @default("default")
  heroMode String   @default("video") // "video" | "shader"
  updatedAt DateTime @updatedAt
}

// ── Configuración por servidor (bot) ─────────────────────────────────
model GuildConfig {
  id                String @id @default(cuid())
  guildId           String @unique
  defaultPrefix     String @default("!")
  officialChannelId String?
  tradeChannelId    String?
  // Canal donde se envían los mensajes de bienvenida a nuevos miembros
  // (configurable con /config bienvenida)
  welcomeChannelId String?
  // Canal (normalmente de voz) cuyo nombre muestra el contador de miembros
  // (configurable con /config contador)
  memberCountChannelId String?
  updatedAt         DateTime @updatedAt
  channels          ChannelConfig[]
}

model ChannelConfig {
  id        String @id @default(cuid())
  guildId   String
  channelId String
  // "official" | "trade"
  role      String?
  // Prefijo único por canal (opcional, hereda el global si es null)
  prefix    String?
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, channelId])
  @@index([guildId])
}
